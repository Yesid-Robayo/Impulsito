<?xml version="1.0" encoding="utf-8"?>
<!--
  Solo para el APK de pruebas de este módulo: la app no lo lleva. El servicio corre en un proceso
  propio para que la prueba de cierre forzado pueda matarlo con la transacción abierta, sin matar
  el proceso que corre las pruebas. No se exporta: solo lo abre la prueba.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service
            android:name="io.github.yesidrobayo.shopledger.data.transaction.WriterProcessService"
            android:exported="false"
            android:process=":writer" />
    </application>
</manifest>

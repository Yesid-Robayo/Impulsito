<?xml version="1.0" encoding="utf-8"?>
<!--
  Solo para el APK de pruebas de este módulo: la app no lo lleva. El servicio corre en un proceso
  propio para que la prueba de cierre forzado pueda matarlo con la transacción abierta, sin matar
  el proceso que corre las pruebas. No se exporta: solo lo abre la prueba.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Las pruebas del destino WebDAV hablan con un servidor falso dentro del propio dispositivo, en
      127.0.0.1 y en claro: solo este APK de pruebas lo permite. La app no lleva nada de esto.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application android:usesCleartextTraffic="true">
        <service
            android:name="io.github.yesidrobayo.shopledger.data.transaction.WriterProcessService"
            android:exported="false"
            android:process=":writer" />
        <!--
          Documentos de ranuras en la caché del APK de pruebas, con fallos a pedido. No se exporta:
          solo lo abre la prueba, en su mismo proceso, y ninguna prueba toca una nube real.
        -->
        <provider
            android:name="io.github.yesidrobayo.shopledger.data.destination.slots.SlotTestProvider"
            android:authorities="${applicationId}.slottest"
            android:exported="false" />
    </application>
</manifest>

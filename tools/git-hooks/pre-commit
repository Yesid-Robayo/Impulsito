#!/bin/sh
# Gancho versionado. Se activa una vez por clon con:
#   git config core.hooksPath tools/git-hooks
# Rechaza el commit si el autor no usa el correo noreply de GitHub, si lo preparado
# agrega un correo que no es de ejemplo, o si gitleaks encuentra un secreto.

noreply='@users\.noreply\.github\.com$'
# Dominios reservados para ejemplos (RFC 2606) y el noreply de GitHub.
allowed='@users\.noreply\.github\.com$|@example\.(com|net|org)$|\.(example|invalid|test)$'

for email in "$(git config user.email)" "${GIT_AUTHOR_EMAIL:-}" "${GIT_COMMITTER_EMAIL:-}"; do
  [ -z "$email" ] && continue
  if ! printf '%s\n' "$email" | grep -Eiq "$noreply"; then
    echo "pre-commit: el correo de Git no es el noreply de GitHub. Configúralo con git config user.email." >&2
    exit 1
  fi
done

if git diff --cached --no-color -U0 --diff-filter=ACMR \
  | grep -E '^\+[^+]' \
  | grep -Eio '[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}' \
  | grep -Eivq "$allowed"; then
  echo "pre-commit: lo preparado agrega un correo real. Quítalo o usa uno de example.com." >&2
  exit 1
fi

# Solo en el repositorio de código, que será público. Se reconoce por su core.hooksPath:
# otro repositorio que use estos ganchos los activa con otra ruta.
if [ "$(git config core.hooksPath)" = "tools/git-hooks" ]; then
  # Hora en UTC, para no revelar la zona horaria del PC.
  for ident in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
    if [ "$(git var "$ident" | awk '{print $NF}')" != "+0000" ]; then
      echo "pre-commit: la hora del commit no está en UTC. En PowerShell: \$env:TZ = \"UTC0\". En Git Bash: export TZ=UTC0." >&2
      exit 1
    fi
  done

  # Nada de lo preparado cita identificadores de los documentos de planificación, que no se publican.
  ids='(^|[^A-Za-z0-9_-])(ADR-[0-9]{4}|(D|R|RF|RNF|RN|RS|SCR|T|SP|UF|CE|RK|ARQ|TM|AR|AS|INC)-[0-9]+)([^0-9]|$)'
  found=$(git diff --cached --no-color -U0 --diff-filter=ACMR | grep -E '^\+[^+]' | grep -E "$ids")
  if [ -n "$found" ]; then
    echo "pre-commit: lo preparado cita un identificador de los documentos de planificación, como el de una decisión o una tarea. Descríbelo con palabras:" >&2
    printf '%s\n' "$found" | head -5 >&2
    exit 1
  fi
fi

exec gitleaks git --pre-commit --redact --staged --verbose

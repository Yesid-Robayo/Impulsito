<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- La biblioteca de trabajos pide servicio en primer plano, y ningún trabajo de la app lo usa: se quita.
         La verificación del manifiesto fusionado falla si vuelve. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />

    <!-- Desde Android 13, los avisos de stock y del respaldo necesitan este permiso. Se pide en contexto, nunca al abrir la
         app, y sin él todo sigue funcionando: la lista de lo que se está acabando y el respaldo se ven en la app. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Desde Android 12, ocultar las ventanas de otras apps dibujadas encima mientras se ve una pantalla o una acción
         sensible, como restaurar o la contraseña del servicio. Se concede al instalar, sin diálogo, y antes de Android 12
         Android lo ignora: ahí queda el filtro de toques tapados. -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

    <!-- El escáner de códigos. Se pide solo al abrir el escáner por primera vez, tras explicar para qué, nunca al abrir la
         app. La cámara corre solo con el escáner a la vista y ningún cuadro se guarda: se lee en memoria y se suelta. Sin el
         permiso, escribir el código sigue funcionando. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Opcionales: sin esto, pedir la cámara la volvería un requisito, y la app no se instalaría en un teléfono sin ella. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <!-- Imprimir etiquetas en una térmica ya emparejada en los ajustes del teléfono. Desde Android 12 se pide al tocar
         Imprimir, nunca al abrir la app; antes basta BLUETOOTH, que se concede al instalar y no muestra diálogo. La app nunca
         busca ni empareja: por eso no pide búsqueda, administración ni ubicación. Sin el permiso queda la hoja PDF. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />

    <!-- Opcional: la app se instala en un teléfono sin Bluetooth, y ahí imprime solo por la hoja PDF. -->
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />

    <!-- Respaldo de Android apagado en sus dos caminos: la nube y la transferencia entre teléfonos. Solo HTTPS.
         Datos frágiles: desde Android 10, al desinstalar el sistema ofrece conservar los datos del negocio. Es una oferta del
         sistema, que no todos los fabricantes muestran: ningún texto de la app la promete. -->
    <application
        android:name=".ShopLedgerApp"
        android:allowBackup="false"
        android:hasFragileUserData="true"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShopLedger">

        <!-- Único componente exportado y único intent-filter de este esqueleto. -->
        <!-- Arranca con la pantalla de inicio de la paleta predeterminada: antes de abrir la base no se sabe otra. -->
        <!-- Cambiar de idioma no recrea la actividad: la misma pantalla vuelve a escribir sus
             textos, sin el parpadeo de destruirla, abrir otra y esperar de nuevo los ajustes de
             la base. Hacen falta los dos valores: sin el sentido de escritura, AppCompat la
             recrea igual en Android 8 a 12. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="locale|layoutDirection"
            android:exported="true"
            android:theme="@style/Theme.App.Starting.IndigoMustard"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Comparte lo que la persona decide sacar por el selector del sistema, solo desde cache/exports/ y solo para leer.
             Sin exportar y sin intent-filter: cada dirección lleva su permiso, que la app concede al compartir. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- La biblioteca de trabajos arranca cuando la app la pide, con la fábrica de la capa de datos, y no sola al
             abrir el proceso. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- El widget de venta rápida. Sin exportar: el sistema le entrega igual sus difusiones, y ninguna otra app le
             puede enviar nada. Solo redibuja y no lee el Intent. Sin montos por defecto y nunca en la pantalla de
             bloqueo. -->
        <receiver
            android:name=".widget.QuickSaleWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_sale_widget_info" />
        </receiver>

        <!-- El mosaico Nueva venta del panel rápido. Exportado porque lo enlaza el sistema, y solo el sistema puede:
             lo protege su permiso. Nunca muestra datos del negocio, y con el teléfono bloqueado abre la app solo tras
             el desbloqueo. -->
        <service
            android:name=".tile.NewSaleTileService"
            android:exported="true"
            android:icon="@drawable/ic_sell"
            android:label="@string/tile_new_sale"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>

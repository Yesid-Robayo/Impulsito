<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- La biblioteca de trabajos pide servicio en primer plano, y ningún trabajo de la app lo usa: se quita.
         La verificación del manifiesto fusionado falla si vuelve. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />

    <!-- Desde Android 13, los avisos de stock y del respaldo necesitan este permiso. Se pide en contexto, nunca al abrir la
         app, y sin él todo sigue funcionando: la lista de lo que se está acabando y el respaldo se ven en la app. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Desde Android 12, ocultar las ventanas de otras apps dibujadas encima mientras se ve una pantalla o una acción
         sensible, como restaurar o la contraseña del servicio. Se concede al instalar, sin diálogo, y antes de Android 12
         Android lo ignora: ahí queda el filtro de toques tapados. -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

    <!-- Respaldo de Android apagado en sus dos caminos: la nube y la transferencia entre teléfonos. Solo HTTPS.
         Datos frágiles: desde Android 10, al desinstalar el sistema ofrece conservar los datos del negocio. Es una oferta del
         sistema, que no todos los fabricantes muestran: ningún texto de la app la promete. -->
    <application
        android:name=".ShopLedgerApp"
        android:allowBackup="false"
        android:hasFragileUserData="true"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShopLedger">

        <!-- Único componente exportado y único intent-filter de este esqueleto. -->
        <!-- Arranca con la pantalla de inicio de la paleta predeterminada: antes de abrir la base no se sabe otra. -->
        <!-- Cambiar de idioma no recrea la actividad: la misma pantalla vuelve a escribir sus
             textos, sin el parpadeo de destruirla, abrir otra y esperar de nuevo los ajustes de
             la base. Hacen falta los dos valores: sin el sentido de escritura, AppCompat la
             recrea igual en Android 8 a 12. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="locale|layoutDirection"
            android:exported="true"
            android:theme="@style/Theme.App.Starting.IndigoMustard"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Comparte lo que la persona decide sacar por el selector del sistema, solo desde cache/exports/ y solo para leer.
             Sin exportar y sin intent-filter: cada dirección lleva su permiso, que la app concede al compartir. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- La biblioteca de trabajos arranca cuando la app la pide, con la fábrica de la capa de datos, y no sola al
             abrir el proceso. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>

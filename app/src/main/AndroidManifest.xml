<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- La biblioteca de trabajos pide servicio en primer plano, y ningún trabajo de la app lo usa: se quita.
         La verificación del manifiesto fusionado falla si vuelve. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />

    <!-- Desde Android 13, los avisos de stock y del respaldo necesitan este permiso. Se pide en contexto, nunca al abrir la
         app, y sin él todo sigue funcionando: la lista de lo que se está acabando y el respaldo se ven en la app. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Respaldo de Android apagado en sus dos caminos: la nube y la transferencia entre teléfonos. Solo HTTPS. -->
    <application
        android:name=".ShopLedgerApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShopLedger">

        <!-- Único componente exportado y único intent-filter de este esqueleto. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- La biblioteca de trabajos arranca cuando la app la pide, con la fábrica de la capa de datos, y no sola al
             abrir el proceso. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>

<resources>
    <!-- Portugués. -->

    <!-- El canal del respaldo, como lo muestran los ajustes de Android. Su ID no cambia nunca: solo su nombre sigue al
         idioma. -->
    <string name="notif_channel_backup">Cópia de segurança</string>

    <!-- Un día sin copia, con un destino conectado. Sin montos ni nombres: se ve entera con el teléfono bloqueado. -->
    <string name="notif_backup_stale_title">Um dia sem cópia</string>
    <string name="notif_backup_stale_body">Tocar para revisar a cópia.</string>

    <!-- Con la nube del teléfono, toca revisar que la copia aparezca. %1$s es el nombre de esa nube, que no se traduce. -->
    <string name="notif_backup_check_title">Falta revisar a cópia em %1$s</string>
    <string name="notif_backup_check_body">Tocar para ver qual horário o arquivo deve mostrar.</string>


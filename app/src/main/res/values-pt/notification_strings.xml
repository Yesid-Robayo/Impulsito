    <string name="notif_stock_out_title">Acabou: %1$s</string>
    <plurals name="notif_stock_many_title">
        <item quantity="one">%1$d produto está acabando</item>
        <item quantity="many">%1$d de produtos estão acabando</item>
        <item quantity="other">%1$d produtos estão acabando</item>
    </plurals>
    <string name="notif_stock_many_body">Tocar para ver.</string>
    <string name="notif_stock_public">Um produto está acabando</string>

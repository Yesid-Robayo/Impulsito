<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Inglés, el respaldo: lo ven también los teléfonos en un idioma sin carpeta propia. -->

    <!-- El canal del respaldo, como lo muestran los ajustes de Android. Su ID no cambia nunca: solo su nombre sigue al
         idioma. -->
    <string name="notif_channel_backup">Backup</string>

    <!-- Un día sin copia, con un destino conectado. Sin montos ni nombres: se ve entera con el teléfono bloqueado. -->
    <string name="notif_backup_stale_title">A day without a backup</string>
    <string name="notif_backup_stale_body">Tap to check the backup.</string>

    <!-- Con la nube del teléfono, toca revisar que la copia aparezca. %1$s es el nombre de esa nube, que no se traduce. -->
    <string name="notif_backup_check_title">The backup in %1$s needs checking</string>
    <string name="notif_backup_check_body">Tap to see what time the file should show.</string>

    <!-- El canal de los avisos de stock, como lo muestran los ajustes de Android. Su ID no cambia nunca. -->
    <string name="notif_channel_stock">Stock alerts</string>

    <!-- Un producto que llegó a su mínimo. %1$s es su nombre: solo se ve con el teléfono desbloqueado. -->
    <string name="notif_stock_low_title">Running low: %1$s</string>
    <!-- %1$s es lo que queda y %2$s el mínimo, cada uno con su unidad. -->
    <string name="notif_stock_low_body">%1$s left. The minimum is %2$s.</string>
    <!-- Un producto que se agotó. %1$s es su nombre. -->
    <string name="notif_stock_out_title">Out of stock: %1$s</string>
    <!-- El resumen de varios avisos a la vez. Solo dice cuántos, así que se ve también con el teléfono bloqueado. -->
    <plurals name="notif_stock_many_title">
        <item quantity="one">%1$d product is running low</item>
        <item quantity="other">%1$d products are running low</item>
    </plurals>
    <string name="notif_stock_many_body">Tap to view.</string>
    <!-- Lo único que se ve con el teléfono bloqueado, y todo lo que se ve con el modo discreto: sin nombre ni cantidad. -->
    <string name="notif_stock_public">A product is running low</string>
    <string name="notif_recovery_check_title">Check the recovery code</string>
    <string name="notif_recovery_check_body">A quick check helps avoid losing access to encrypted backups.</string>
</resources>

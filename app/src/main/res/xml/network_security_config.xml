<?xml version="1.0" encoding="utf-8"?>
<!-- Solo HTTPS y solo CA del sistema. Sin domain-config ni debug-overrides. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
